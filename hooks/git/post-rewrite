#!/bin/sh
# AiDex global git hook -- post-rewrite.
#
# Fires after `git commit --amend` or `git rebase` (git calls it once for
# the whole operation, not once per rewritten commit). Its argv[1] is the
# command that triggered it ("amend" or "rebase"); the actual payload is on
# stdin, one "<old-sha> <new-sha> [extra]" line per rewritten commit. Union
# the file changes of every new-sha and queue them as a single batch -- the
# debounce in aidex-reindex-common.sh is what actually protects a 30-commit
# rebase from turning into 30 reindexes, this hook just needs to not queue
# duplicate work per rewritten commit within that one invocation either.

. "$(dirname "$0")/aidex-reindex-common.sh"

repo_root="$(aidex_repo_root)"
aidex_has_index "$repo_root" || exit 0

files=""
while read -r old_sha new_sha _rest; do
    [ -z "$new_sha" ] && continue
    changed="$(git diff-tree --no-commit-id --name-only -r "$new_sha" 2>/dev/null)"
    [ -n "$changed" ] && files="$files
$changed"
done

printf '%s\n' "$files" | sort -u | aidex_queue_files "$repo_root"

exit 0
